{
  "name": "remote-exec",
  "version": "1.0.0",
  "description": "面向受信任 Linux 主机的轻量 WSS 远程执行 daemon，支持 Pi agent 接入和单跳 relay。",
  "main": "lib/client.js",
  "bin": {
    "remote-exec": "server.js"
  },
  "scripts": {
    "check": "node --check server.js && node --check lib/client.js && node --check tui-client.js && node --check test-client.js && node --check fuzz-client.js && node --check test-runner.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:integration": "node test-runner.js",
    "test": "npm run check && npm run typecheck && npm run test:integration",
    "start": "node server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "server.js",
    "lib/",
    "tui-client.js",
    "rex.sh",
    "pi-extension/remote-exec.ts",
    "pi-extension/pi-coding-agent.d.ts",
    "test-client.js",
    "fuzz-client.js",
    "test-runner.js",
    "tsconfig.json"
  ],
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
